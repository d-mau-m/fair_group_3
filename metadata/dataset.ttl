@prefix dcat:   <http://www.w3.org/ns/dcat#> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix md:     <https://w3id.org/FAIR-course-UT/2025-2026/group3/metadata#> .

# ---------------------------------------------------------------- dataset
md:dataset a dcat:Dataset ;
    dct:title "Tate collection artists, FAIRified"@en ;
    dct:description """The 3,532 artists of the Tate collection (snapshot of October 2014), transformed to RDF with schema.org.
Artists, their birth and death places and countries are linked to Wikidata; schools and collectives are typed as groups.
Derived from Tate's artist_data.csv (CC0) and modified by group 3 of the FAIR Data Engineering course, University of Twente."""@en ;
    dct:identifier "https://w3id.org/FAIR-course-UT/2025-2026/group3/data" ;
    dct:creator md:sepehr, md:mauricio ;
    dct:publisher md:utwente ;
    dct:issued "2026-10-23"^^xsd:date ;
    dcat:version "1.0" ;
    dct:license <http://creativecommons.org/publicdomain/zero/1.0/> ;
    dct:language <http://publications.europa.eu/resource/authority/language/ENG> ;
    dcat:keyword "art"@en, "artists"@en, "Tate"@en, "museum collection"@en, "linked data"@en ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ;
    dct:temporal "1497/2014" ;
    prov:wasDerivedFrom <https://github.com/tategallery/collection> ;
    prov:wasGeneratedBy md:fairification ;
    dct:conformsTo <https://w3id.org/FAIR-course-UT/2025-2026/group3/ont> ;
    dcat:distribution md:dist-rdf, md:dist-csv-prepared, md:dist-csv-original .

# ---------------------------------------------------------------- distributions
md:dist-rdf a dcat:Distribution ;
    dct:title "Artists as RDF (Turtle)"@en ;
    dcat:downloadURL <https://raw.githubusercontent.com/d-mau-m/fair_group_3/refs/heads/main/data/rdf/artists.ttl> ;
    dcat:accessURL   <https://w3id.org/FAIR-course-UT/2025-2026/group3/data> ;
    dcat:mediaType <http://www.iana.org/assignments/media-types/text/turtle> ;
    dct:license <http://creativecommons.org/publicdomain/zero/1.0/> ;
    dct:conformsTo <https://w3id.org/FAIR-course-UT/2025-2026/group3/shapes> ;
    dcat:byteSize "1790934"^^xsd:nonNegativeInteger .

md:dist-csv-prepared a dcat:Distribution ;
    dct:title "Prepared and reconciled table (CSV)"@en ;
    dcat:downloadURL <https://raw.githubusercontent.com/d-mau-m/fair_group_3/refs/heads/main/data/prepared/artist-data-csv.csv> ;
    dcat:accessURL   <https://github.com/d-mau-m/fair_group_3> ;
    dcat:mediaType <http://www.iana.org/assignments/media-types/text/csv> ;
    dct:license <http://creativecommons.org/publicdomain/zero/1.0/> .

md:dist-csv-original a dcat:Distribution ;
    dct:title "Original Tate artist table (CSV, unchanged)"@en ;
    dcat:downloadURL <https://raw.githubusercontent.com/d-mau-m/fair_group_3/refs/heads/main/data/original/artist_data.csv> ;
    dcat:accessURL   <https://github.com/tategallery/collection> ;
    dcat:mediaType <http://www.iana.org/assignments/media-types/text/csv> ;
    dct:license <http://creativecommons.org/publicdomain/zero/1.0/> .

# ---------------------------------------------------------------- provenance
md:fairification a prov:Activity ;
    rdfs:label "FAIRification of the Tate artist data"@en ;
    rdfs:comment "Cleaning, Wikidata reconciliation and RDF transformation in OpenRefine; history in openrefine_history/history.json."@en ;
    prov:used <https://github.com/tategallery/collection/blob/a51d8afc988ed083557e2950f4d0b644e7719f4a/artist_data.csv> ;
    prov:wasAssociatedWith md:sepehr, md:mauricio ;
    prov:endedAtTime "2026-10-23T00:00:00Z"^^xsd:dateTime .

# ---------------------------------------------------------------- agents
md:sepehr   a foaf:Person ; foaf:name "Sepehr Shamlooheravi" .
md:mauricio a foaf:Person ; foaf:name "Mauricio Marin Araya" .
md:utwente  a foaf:Organization ; foaf:name "University of Twente" ; foaf:homepage <https://www.utwente.nl> .
