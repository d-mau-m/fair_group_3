@prefix : <https://w3id.org/FAIR-course-UT/2025-2026/group3/metadata-shapes#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix dash: <http://datashapes.org/dash#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .

:GeneralGroup
  a sh:PropertyGroup ;
  rdfs:label "General" ;
  sh:order 0 .

:DistributionShape
  a sh:NodeShape ;
  rdfs:label "Tate artists distribution" ;
  dct:description "Downloadable files of the Tate artists dataset." ;
  sh:targetClass dcat:Distribution ;
  sh:property [
    sh:path dct:title ;
    sh:name "Title" ;
    sh:datatype rdf:langString ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:order 1 ;
    dash:editor dash:TextFieldEditor ;
    sh:group :GeneralGroup
  ] ;
  sh:property [
    sh:path dcat:downloadURL ;
    sh:name "Download URL" ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:order 2 ;
    dash:editor dash:URIEditor ;
    sh:group :GeneralGroup
  ] ;
  sh:property [
    sh:path dcat:accessURL ;
    sh:name "Access URL" ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:order 3 ;
    dash:editor dash:URIEditor ;
    sh:group :GeneralGroup
  ] ;
  sh:property [
    sh:path dcat:mediaType ;
    sh:name "Media type" ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:pattern "^http://www\\.iana\\.org/assignments/media-types/" ;
    sh:order 4 ;
    dash:editor dash:URIEditor ;
    sh:group :GeneralGroup
  ] ;
  sh:property [
    sh:path dct:license ;
    sh:name "Licence" ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:order 5 ;
    dash:editor dash:URIEditor ;
    sh:group :GeneralGroup
  ] ;
  sh:property [
    sh:path dcat:byteSize ;
    sh:name "Size (bytes)" ;
    sh:datatype xsd:nonNegativeInteger ;
    sh:maxCount 1 ;
    sh:order 6 ;
    dash:editor dash:TextFieldEditor ;
    sh:group :GeneralGroup
  ] ;
  sh:property [
    sh:path dct:conformsTo ;
    sh:name "Conforms to" ;
    sh:nodeKind sh:IRI ;
    sh:order 7 ;
    dash:editor dash:URIEditor ;
    sh:group :GeneralGroup
  ] .