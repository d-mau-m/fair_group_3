@prefix :     <https://w3id.org/FAIR-course-UT/2025-2026/group3/metadata-shapes#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix dash: <http://datashapes.org/dash#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .

# Contour schema 1/2 - Tate artists dataset (group 3)
:DatasetShape a sh:NodeShape ;
  rdfs:label "Tate artists dataset" ;
  dct:description "Metadata schema (DCAT, Dublin Core, PROV-O) for the FAIRified Tate collection artist data, group 3, FAIR Data Engineering, University of Twente." ;
  sh:targetClass dcat:Dataset ;
  sh:property [ sh:order 1 ;  sh:name "Title" ;       sh:path dct:title ;       sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:langString ; sh:maxLength 120 ; dash:editor dash:TextFieldWithLangEditor ] ;
  sh:property [ sh:order 2 ;  sh:name "Description" ; sh:path dct:description ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:langString ; dash:editor dash:TextAreaWithLangEditor ] ;
  sh:property [ sh:order 3 ;  sh:name "Identifier" ;  sh:path dct:identifier ;  sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; dash:editor dash:TextFieldEditor ] ;
  sh:property [ sh:order 4 ;  sh:name "Creator" ;     sh:path dct:creator ;     sh:minCount 1 ; sh:nodeKind sh:IRI ; dash:editor dash:URIEditor ] ;
  sh:property [ sh:order 5 ;  sh:name "Publisher" ;   sh:path dct:publisher ;   sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; dash:editor dash:URIEditor ] ;
  sh:property [ sh:order 6 ;  sh:name "Issued" ;      sh:path dct:issued ;      sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ; dash:editor dash:DatePickerEditor ] ;
  sh:property [ sh:order 7 ;  sh:name "Modified" ;    sh:path dct:modified ;    sh:maxCount 1 ; sh:datatype xsd:date ; dash:editor dash:DatePickerEditor ] ;
  sh:property [ sh:order 8 ;  sh:name "Version" ;     sh:path dcat:version ;    sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:maxLength 10 ; dash:editor dash:TextFieldEditor ] ;
  sh:property [ sh:order 9 ;  sh:name "Licence" ;     sh:path dct:license ;     sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; dash:editor dash:URIEditor ] ;
  sh:property [ sh:order 10 ; sh:name "Language" ;    sh:path dct:language ;    sh:minCount 1 ; sh:nodeKind sh:IRI ; dash:editor dash:URIEditor ] ;
  sh:property [ sh:order 11 ; sh:name "Keyword" ;     sh:path dcat:keyword ;    sh:minCount 1 ; sh:datatype rdf:langString ; dash:editor dash:TextFieldWithLangEditor ] ;
  sh:property [ sh:order 12 ; sh:name "Theme" ;       sh:path dcat:theme ;      sh:minCount 1 ; sh:nodeKind sh:IRI ; dash:editor dash:URIEditor ] ;
  sh:property [ sh:order 13 ; sh:name "Time span" ;   sh:path dct:temporal ;    sh:maxCount 1 ; sh:datatype xsd:string ; dash:editor dash:TextFieldEditor ] ;
  sh:property [ sh:order 14 ; sh:name "Derived from (source)" ; sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:nodeKind sh:IRI ; dash:editor dash:URIEditor ] ;
  sh:property [ sh:order 15 ; sh:name "Generated by (activity)" ; sh:path prov:wasGeneratedBy ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; dash:editor dash:URIEditor ] ;
  sh:property [ sh:order 16 ; sh:name "Conforms to" ; sh:path dct:conformsTo ; sh:nodeKind sh:IRI ; dash:editor dash:URIEditor ] ;
  sh:property [ sh:order 17 ; sh:name "Distribution" ; sh:path dcat:distribution ; sh:minCount 1 ; sh:nodeKind sh:IRI ; dash:editor dash:URIEditor ] .
