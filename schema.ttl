@prefix : <https://w3id.org/FAIR-course-UT/2025-2026/group3/metadata-shapes#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix dash: <http://datashapes.org/dash#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:GeneralGroup
  a sh:PropertyGroup ;
  rdfs:label "General" ;
  sh:order 0 .

:DatasetShape
  a sh:NodeShape ;
  sh:targetClass dcat:Dataset ;
  sh:property [
    sh:path dct:title ;
    sh:name "Title" ;
    sh:datatype rdf:langString ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:maxLength 120 ;
    sh:order 1 ;
    dash:editor dash:TextFieldEditor ;
    sh:group :GeneralGroup
  ] ;
  sh:property [
    sh:path dct:description ;
    sh:name "Description" ;
    sh:datatype rdf:langString ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:order 2 ;
    dash:editor dash:TextFieldEditor ;
    sh:group :GeneralGroup
  ] ;
  sh:property [
    sh:path dct:identifier ;
    sh:name "Identifier" ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:order 3 ;
    dash:editor dash:TextFieldEditor ;
    sh:group :GeneralGroup
  ] ;
  sh:property [
    sh:path dct:creator ;
    sh:name "Creator" ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:order 4 ;
    dash:editor dash:URIEditor ;
    sh:group :GeneralGroup
  ] ;
  sh:property [
    sh:path dct:publisher ;
    sh:name "Publisher" ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:order 5 ;
    dash:editor dash:URIEditor ;
    sh:group :GeneralGroup
  ] ;
  sh:property [
    sh:path dct:issued ;
    sh:name "Issued" ;
    sh:datatype xsd:date ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:order 6 ;
    dash:editor dash:DatePickerEditor ;
    sh:group :GeneralGroup
  ] ;
  sh:property [
    sh:path dct:modified ;
    sh:name "Modified" ;
    sh:datatype xsd:date ;
    sh:maxCount 1 ;
    sh:order 7 ;
    dash:editor dash:DatePickerEditor ;
    sh:group :GeneralGroup
  ] ;
  sh:property [
    sh:path dcat:version ;
    sh:name "Version" ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:maxLength 10 ;
    sh:order 8 ;
    dash:editor dash:TextFieldEditor ;
    sh:group :GeneralGroup
  ] ;
  sh:property [
    sh:path dct:license ;
    sh:name "Licence" ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:order 9 ;
    dash:editor dash:URIEditor ;
    sh:group :GeneralGroup
  ] ;
  sh:property [
    sh:path dct:language ;
    sh:name "Language" ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:order 10 ;
    dash:editor dash:URIEditor ;
    sh:group :GeneralGroup
  ] ;
  sh:property [
    sh:path dcat:keyword ;
    sh:name "Keyword" ;
    sh:datatype rdf:langString ;
    sh:minCount 1 ;
    sh:order 11 ;
    dash:editor dash:TextFieldEditor ;
    sh:group :GeneralGroup
  ] ;
  sh:property [
    sh:path dcat:theme ;
    sh:name "Theme" ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:order 12 ;
    dash:editor dash:URIEditor ;
    sh:group :GeneralGroup
  ] ;
  sh:property [
    sh:path dct:temporal ;
    sh:name "Time span" ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:order 13 ;
    dash:editor dash:TextFieldEditor ;
    sh:group :GeneralGroup
  ] ;
  sh:property [
    sh:path prov:wasDerivedFrom ;
    sh:name "Derived from (source)" ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:order 14 ;
    dash:editor dash:URIEditor ;
    sh:group :GeneralGroup
  ] ;
  sh:property [
    sh:path prov:wasGeneratedBy ;
    sh:name "Generated by (activity)" ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1 ;
    sh:order 15 ;
    dash:editor dash:URIEditor ;
    sh:group :GeneralGroup
  ] ;
  sh:property [
    sh:path dct:conformsTo ;
    sh:name "Conforms to" ;
    sh:nodeKind sh:IRI ;
    sh:order 16 ;
    dash:editor dash:URIEditor ;
    sh:group :GeneralGroup
  ] ;
  sh:property [
    sh:path dcat:distribution ;
    sh:name "Distribution" ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:order 17 ;
    dash:editor dash:URIEditor ;
    sh:group :GeneralGroup
  ] .

# ── Preserved: SHACL/RDF Contour does not model. Round-tripped as-is. ──
<https://w3id.org/FAIR-course-UT/2025-2026/group3/metadata-shapes#DatasetShape> <http://www.w3.org/ns/shacl#name> "Tate artists dataset" .