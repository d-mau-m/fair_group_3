###  https://w3id.org/FAIR-course-UT/2025-2026/group3/ont#livingAtSnapshot
:livingAtSnapshot rdf:type owl:DatatypeProperty ;
                  rdfs:range xsd:boolean ;
                  rdfs:comment "True if the artist was alive when Tate published the source data"@en ;
                  rdfs:label "living at snapshot"@en .


