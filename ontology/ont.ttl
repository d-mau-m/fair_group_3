<https://w3id.org/FAIR-course-UT/2025-2026/group3/ont> rdf:type owl:Ontology ;
                                                        dcterms:creator "Mauricio Marin Araya" ,
                                                                        "Sepehr Shamlooheravi" ;
                                                        dcterms:license <http://creativecommons.org/publicdomain/zero/1.0/> ;
                                                        rdfs:comment "Terms defined by FAIR Data Engineering group 3 (University of Twente, 2025-2026) for the FAIRified Tate collection artist data, where no existing vocabulary provided a suitable term."@en ;
